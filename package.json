{
  "name": "chauka",
  "version": "1.0.0",
  "description": "Chauka — Real-Time Restaurant Engine. Two separate projects: restaurant-public (marketing site) and restaurant-local (self-hosted restaurant system).",
  "private": true,
  "workspaces": [
    "restaurant-public",
    "restaurant-local"
  ],
  "scripts": {
    "start": "npm run start:local",
    "start:local": "npm run start --workspace=restaurant-local",
    "start:public": "npm run start --workspace=restaurant-public",
    "start:license": "npm run start:license --workspace=restaurant-local",
    "dev": "npm run start:local",
    "test": "npm test --workspace=restaurant-public && npm test --workspace=restaurant-local"
  },
  "keywords": [
    "restaurant",
    "pos",
    "kds",
    "kitchen-display",
    "socket.io",
    "real-time",
    "qr-ordering"
  ],
  "license": "UNLICENSED"
}
